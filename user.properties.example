# Copy to ./user.properties (git-ignored) in the directory you start the proxy from.
# Any property from src/main/resources/application.yml can be overridden here.

# --- AutoSys server (origin only, no path)
autosys.base-url=https://your-autosys-webui-host:8443
autosys.environment=DEV

# --- Proxy port
server.port=8080

# --- TLS trust for AutoSys (internal CA); JVM default trust if omitted
#autosys.http.truststore=file:/path/to/truststore.p12
#autosys.http.truststore-password=${TRUSTSTORE_PASSWORD}

# --- Entry pages (AutoSys-relative)
#autosys.proxy.start-page=/ui/Login.html
#autosys.webui.login.landing-page=/ui/Home.html

# --- Login exchange (see README "Teach the proxy how your AutoSys login looks")
autosys.webui.login.discovery-log=true
autosys.webui.login.path=/path/to/login/submit
autosys.webui.login.username-field=username
autosys.webui.login.password-field=password
# Every rule that is set must hold for a login to count as successful. Compare the [discovery]
# lines of a good and a bad login and pick what differs. Pick one of the two styles:
#
# a) classic form login: answered with a redirect
#autosys.webui.login.success.statuses=302
#autosys.webui.login.success.location-reject-pattern=(?i)login|error
#
# b) XHR/JSON login (the page's JavaScript posts the credentials): answered with 200 both ways,
#    so add a rule only a good login passes - a cookie set only on success, or a failure marker
#autosys.webui.login.success.statuses=200
#autosys.webui.login.success.cookie=JSESSIONID
#autosys.webui.login.failure-marker="success":false

# --- Capture mode: record the UI's requests/responses (secrets masked) into ./captures/<run>/
#autosys.capture.enabled=true

# --- Logging
#logging.file.name=logs/a-proxy.log
#autosys.proxy.access-log=true
#logging.level.com.testing.aproxy=DEBUG
